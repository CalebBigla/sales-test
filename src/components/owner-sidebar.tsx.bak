import * as React from "react";
import { Link } from "@tanstack/react-router";
import { 
  LayoutDashboard, 
  Users, 
  Package, 
  TrendingUp, 
  Settings, 
  FileText,
  Target,
  Bell
} from "lucide-react";

interface SidebarItem {
  icon: React.ElementType;
  label: string;
  href: string;
  active?: boolean;
}

export function OwnerSidebar() {
  const pathname = typeof window !== 'undefined' ? window.location.pathname : '/owner';
  
  const navItems: SidebarItem[] = [
    {
      icon: LayoutDashboard,
      label: "Dashboard",
      href: "/owner",
      active: pathname === "/owner"
    },
    {
      icon: TrendingUp,
      label: "Sales",
      href: "/owner/sales",
      active: pathname.startsWith("/owner/sales")
    },
    {
      icon: Package,
      label: "Inventory",
      href: "/owner/inventory",
      active: pathname.startsWith("/owner/inventory")
    },
    {
      icon: Users,
      label: "Team",
      href: "/owner/team",
      active: pathname.startsWith("/owner/team")
    },
    {
      icon: Target,
      label: "Targets",
      href: "/owner/targets",
      active: pathname.startsWith("/owner/targets")
    },
    {
      icon: FileText,
      label: "Reports",
      href: "/owner/reports",
      active: pathname.startsWith("/owner/reports")
    },
    {
      icon: Bell,
      label: "Activity",
      href: "/owner/activity",
      active: pathname.startsWith("/owner/activity")
    },
    {
      icon: Settings,
      label: "Settings",
      href: "/settings",
      active: pathname.startsWith("/settings")
    }
  ];

  return (
    <aside className="w-64 min-h-screen bg-[#1E293B] text-white flex flex-col">
      {/* Logo Section */}
      <div className="p-6 border-b border-slate-700">
        <div className="flex items-center gap-3">
          <div className="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
            <span className="text-white font-bold text-lg">S</span>
          </div>
          <span className="font-semibold text-lg">SalesFlow</span>
        </div>
      </div>

      {/* Navigation Items */}
      <nav className="flex-1 py-6">
        <ul className="space-y-1 px-3">
          {navItems.map((item) => {
            const Icon = item.icon;
            return (
              <li key={item.href}>
                <Link
                  to={item.href}
                  className={`
                    flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                    ${item.active 
                      ? 'bg-blue-600 text-white' 
                      : 'text-slate-300 hover:bg-slate-700 hover:text-white'
                    }
                  `}
                >
                  <Icon className="h-5 w-5" />
                  <span className="text-sm font-medium">{item.label}</span>
                </Link>
              </li>
            );
          })}
        </ul>
      </nav>

      {/* Footer Section (Optional) */}
      <div className="p-4 border-t border-slate-700">
        <div className="text-xs text-slate-400 text-center">
          © 2024 SalesFlow Pro
        </div>
      </div>
    </aside>
  );
}
